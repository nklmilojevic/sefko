{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>nklmilojevic/renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Go updates land as one weekly PR. The vendor-hash workflow fixes vendorHash in package.nix on it.",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go modules",
      "schedule": [
        "before 6am on monday"
      ],
      "automerge": false
    }
  ]
}
